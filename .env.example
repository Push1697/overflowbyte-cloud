# ==========================================
# Hashnode Configuration (blog.overflowbyte.cloud)
# ==========================================
# Get your PAT from Hashnode: Account Settings > Developer Settings > Personal Access Tokens
# HASHNODE_PAT=your_hashnode_personal_access_token_here

# Publication Host and ID
HASHNODE_PUBLICATION_HOST=blog.overflowbyte.cloud
# Find your publication ID with: hashnode --host blog.overflowbyte.cloud publication get
# HASHNODE_PUBLICATION_ID=your_publication_id_here

# ==========================================
# Medium Configuration (overflowbyte.medium.com)
# ==========================================
# Get your Integration Token: Medium -> Settings -> Security and Apps -> Integration Tokens
# MEDIUM_TOKEN=your_medium_integration_token_here
MEDIUM_PUBLICATION_URL=https://overflowbyte.medium.com/
