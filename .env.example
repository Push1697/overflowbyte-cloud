# ---- Payload CMS (docs/cms.md) ----
# Local dev works with no settings: SQLite file payload.db + a dev secret.
# Production refuses to start without a secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Hosted database for production. The SQLite adapter speaks libSQL, so a
# Turso database works with no code change:
# PAYLOAD_DATABASE_URL=libsql://overflowbyte-<you>.turso.io
# PAYLOAD_DATABASE_AUTH_TOKEN=
# Vercel deploy hook; the CMS calls it after every save so the site rebuilds.
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
# Set to 0 to stop admin saves rewriting posts/*.md locally.
# CMS_WRITE_FILES=1

# ---- Cross-platform sync (scripts/sync-cross-platform.mjs) ----
# No keys needed: Hashnode sitemap + <post>.md, Medium RSS.
# SYNC_FORCE=1 re-fetches already-synced files (never hand-written ones).
# SYNC_FORCE=0

# ---- Existing publishing scripts (scripts/hashnode-*.mjs, medium.mjs) ----
# HASHNODE_API_KEY=
# MEDIUM_INTEGRATION_TOKEN=
