{
  "name": "overflowbyte-cloud",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node init && next dev",
    "build": "node init && next build",
    "start": "node init && next start",
    "lint": "eslint .",
    "medium:whoami": "node scripts/medium.mjs whoami",
    "medium:publish": "node scripts/medium.mjs publish",
    "corpus": "node scripts/corpus.mjs",
    "hashnode:prep": "node scripts/hashnode-prep.mjs",
    "hashnode:verify": "node scripts/hashnode-verify.mjs",
    "hashnode:publish": "node scripts/hashnode-publish.mjs",
    "sync:cross-platform": "node scripts/sync-cross-platform.mjs",
    "cms:push": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/cms-push.mts",
    "cms:pull": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/cms-pull.mts",
    "cms:importmap": "payload generate:importmap --disable-transpile",
    "payload": "payload --disable-transpile",
    "cms:types": "payload generate:types --disable-transpile",
    "cms:backup": "node scripts/cms-backup.mjs",
    "newsletter:banner": "node scripts/newsletter-banner.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@payloadcms/db-sqlite": "^3.91.0",
    "@payloadcms/next": "^3.91.0",
    "@payloadcms/richtext-lexical": "^3.91.0",
    "@payloadcms/ui": "^3.91.0",
    "@vercel/analytics": "^1.4.1",
    "graphql": "^16.14.2",
    "gray-matter": "^4.0.3",
    "mermaid": "^12.3.0",
    "next": "^16.4.3",
    "payload": "^3.91.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "typescript": "^5.9.3"
  }
}
